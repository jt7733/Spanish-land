{
  "name": "mi-espanol",
  "version": "1.0.0",
  "description": "Mi Español — El Reino de Solaria",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.justin.miespanol",
    "productName": "Mi Espanol",
    "files": ["**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
